{
    "name": "quotelock-studio",
    "private": true,
    "version": "0.1.0",
    "description": "QuoteLock Studio - design and publish your lock screen quotes",
    "author": "QuoteLock",
    "type": "module",
    "main": "electron/main.cjs",
    "scripts": {
        "dev": "concurrently -k -n vite,app -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
        "build": "tsc -b && vite build",
        "typecheck": "tsc -b",
        "lint": "oxlint",
        "icon": "node scripts/make-icon.mjs",
        "dist": "npm run build && npm run icon && electron-builder --win nsis",
        "audit": "node scripts/audit-render.mjs && node scripts/ui-audit.mjs && node scripts/pages-audit.mjs",
        "audit:packaged": "node scripts/packaged-test.mjs && node scripts/publish-packaged.mjs",
        "start": "cross-env NODE_ENV=production electron .",
        "render": "node shared/render.mjs"
    },
    "build": {
        "appId": "com.quotelock.studio",
        "productName": "QuoteLock",
        "directories": {
            "output": "release",
            "buildResources": "build"
        },
        "files": [
            "dist/**/*",
            "electron/**/*",
            "shared/**/*",
            "package.json"
        ],
        "extraResources": [
            {
                "from": "../app.ps1",
                "to": "engine/app.ps1"
            },
            {
                "from": "../run-hidden.vbs",
                "to": "engine/run-hidden.vbs"
            },
            {
                "from": "shared/render.mjs",
                "to": "engine/shared/render.mjs"
            },
            {
                "from": "shared/card.mjs",
                "to": "engine/shared/card.mjs"
            },
            {
                "from": "shared/providers.json",
                "to": "engine/shared/providers.json"
            }
        ],
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "icon": "build/icon.ico"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "QuoteLock"
        }
    },
    "dependencies": {
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-popover": "^1.3.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slider": "^1.6.1",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.71.0",
        "motion": "^14.12.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.5",
        "@types/node": "^24.19.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.3.0",
        "concurrently": "^10.0.7",
        "cross-env": "^10.1.0",
        "electron": "^45.2.3",
        "electron-builder": "^26.18.0",
        "oxlint": "^1.93.0",
        "playwright-core": "^1.65.0",
        "png-to-ico": "^3.0.2",
        "tailwindcss": "^4.3.5",
        "typescript": "~7.0.2",
        "vite": "^8.3.7",
        "wait-on": "^9.5.1"
    }
}
